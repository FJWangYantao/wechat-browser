{
  "manifest_version": 3,
  "name": "微信读书样式定制",
  "short_name": "WeRead Style",
  "version": "0.3.0",
  "description": "自定义微信读书网页版的阅读样式，支持像知乎一样连续滚动、自动滚屏，以及划选文字问 AI 的 AI 陪读。",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "微信读书样式",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-styles": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "开启 / 关闭自定义样式"
    },
    "toggle-autoscroll": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "开始 / 暂停自动滚屏"
    },
    "toggle-ai-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "打开 / 关闭 AI 陪读面板"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://weread.qq.com/*"
      ],
      "js": [
        "src/content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://weread.qq.com/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/content/flow.js",
        "src/content/ai.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
